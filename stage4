if id_mismatch_count != 0 or question_mismatch_count != 0:
    raise ValueError(
        f"Stage 4 row alignment failed. "
        f"ID mismatches: {id_mismatch_count}, "
        f"question mismatches: {question_mismatch_count}"
    )

print("\nRow alignment check passed.")
